---
const { title = '留白 · 个人博客', description = '记录思考、学习与创造。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">留白<span>.</span></a>
      <nav aria-label="主导航">
        <a href="/">文章</a>
        <a href="/tags">标签</a>
        <a href="/about">关于</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} 留白 · 认真生活，缓慢生长。</footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600;700&display=swap');
  :root { --ink:#1d2823; --muted:#617069; --paper:#f8f6f0; --line:#dcded6; --accent:#e87648; --sage:#dfe7d9; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:'Noto Serif SC', Georgia, serif; line-height:1.8; }
  a { color:inherit; text-decoration:none; }
  .site-header { max-width:1040px; margin:auto; height:86px; padding:0 28px; display:flex; align-items:center; justify-content:space-between; }
  .brand { font-size:1.55rem; font-weight:700; letter-spacing:.08em; }
  .brand span { color:var(--accent); }
  nav { display:flex; gap:26px; font-size:.92rem; }
  nav a { color:var(--muted); } nav a:hover { color:var(--accent); }
  main { max-width:1040px; margin:auto; padding:38px 28px 84px; }
  footer { border-top:1px solid var(--line); text-align:center; padding:28px; color:var(--muted); font: .75rem 'DM Mono', monospace; }
  .eyebrow { color:var(--accent); font: .72rem 'DM Mono', monospace; letter-spacing:.12em; text-transform:uppercase; }
  .tag { display:inline-block; color:var(--muted); border:1px solid var(--line); border-radius:999px; padding:2px 10px; margin-right:6px; font-size:.78rem; line-height:1.6; }
  @media (max-width:600px) { .site-header { height:72px; padding:0 18px; } nav { gap:15px; } main { padding:28px 18px 60px; } }
</style>
