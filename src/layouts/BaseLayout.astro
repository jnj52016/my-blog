---
const { title = '留白 · 个人博客', description = '记录思考、学习与创造。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">博客<span>.</span></a>
      <nav aria-label="主导航">
        <a href="/">文章</a>
        <a href="/tags">标签</a>
        <a href="/about">关于</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} 留白 · 认真生活，缓慢生长。</footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=DM+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600;700&display=swap');
  :root { color-scheme:dark; --ink:#e7e9ec; --muted:#8d949e; --paper:#080a0d; --surface:#10141a; --surface-raised:#171c23; --line:#2a3038; --line-strong:#414955; --accent:#f2c230; --accent-soft:rgba(242,194,48,.13); }
  * { box-sizing:border-box; }
  html { background:var(--paper); scroll-behavior:smooth; }
  body { min-height:100vh; margin:0; background:radial-gradient(circle at 82% 4%, rgba(242,194,48,.075), transparent 28rem), linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.014) 1px, transparent 1px), var(--paper); background-size:auto,48px 48px,48px 48px,auto; color:var(--ink); font-family:'Noto Serif SC',Georgia,serif; line-height:1.8; text-rendering:optimizeLegibility; }
  body::after { position:fixed; inset:0; z-index:10; background:radial-gradient(circle at center,transparent 45%,rgba(0,0,0,.36) 100%); content:''; pointer-events:none; }
  ::selection { background:var(--accent); color:#080a0d; }
  a { color:inherit; text-decoration:none; transition:color .2s ease,border-color .2s ease,background-color .2s ease; }
  a:focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  h1,h2,h3 { font-family:'Barlow Condensed','Noto Serif SC',sans-serif; font-weight:700; }
  .site-header { position:sticky; top:0; z-index:20; max-width:1040px; height:86px; margin:auto; padding:0 28px; border-bottom:1px solid var(--line); background:rgba(8,10,13,.82); backdrop-filter:blur(14px); display:flex; align-items:center; justify-content:space-between; }
  .brand { font-family:'Barlow Condensed','Noto Serif SC',sans-serif; font-size:1.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .brand span { color:var(--accent); text-shadow:0 0 18px rgba(242,194,48,.35); }
  nav { display:flex; gap:28px; font:.78rem 'DM Mono',monospace; letter-spacing:.08em; }
  nav a { position:relative; color:var(--muted); padding:8px 0; }
  nav a::after { position:absolute; right:0; bottom:2px; left:0; height:1px; background:var(--accent); content:''; transform:scaleX(0); transform-origin:right; transition:transform .2s ease; }
  nav a:hover { color:var(--ink); }
  nav a:hover::after { transform:scaleX(1); transform-origin:left; }
  main { position:relative; z-index:1; max-width:1040px; min-height:calc(100vh - 180px); margin:auto; padding:38px 28px 84px; }
  footer { position:relative; z-index:11; border-top:1px solid var(--line); background:rgba(8,10,13,.75); text-align:center; padding:30px; color:var(--muted); font:.7rem 'DM Mono',monospace; letter-spacing:.08em; }
  .eyebrow { color:var(--accent); font:.7rem 'DM Mono',monospace; letter-spacing:.14em; text-transform:uppercase; }
  .eyebrow::before { content:'// '; color:var(--line-strong); }
  .tag { display:inline-block; color:var(--muted); border:1px solid var(--line); border-radius:2px; background:rgba(16,20,26,.7); padding:3px 10px; margin-right:6px; font:.72rem 'DM Mono',monospace; line-height:1.6; letter-spacing:.04em; }
  .tag:hover { color:var(--paper); border-color:var(--accent); background:var(--accent); }
  @media (max-width:600px) { body { background-size:auto,34px 34px,34px 34px,auto; } .site-header { height:72px; padding:0 18px; } .brand { font-size:1.55rem; } nav { gap:16px; font-size:.72rem; } main { padding:28px 18px 60px; } }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition-duration:.01ms !important; } }
</style>
