---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="关于 · 留白">
  <section class="page"><p class="eyebrow">About this space</p><h1>你好，欢迎来到留白。</h1><p>这是一个属于自己的小小角落，用来记录值得反复咀嚼的想法，也分享学习和创造路上的发现。</p><p>愿我们在快速变化的世界里，依然能留一点时间给好奇、阅读和真诚的表达。</p></section>
</BaseLayout>
<style>
  .page { max-width:720px; margin:54px auto; padding:42px 44px; border:1px solid var(--line); border-top-color:var(--accent); background:linear-gradient(135deg,rgba(242,194,48,.05),transparent 32%),rgba(16,20,26,.72); font-size:1.06rem; }
  h1 { font-size:clamp(2.8rem,6vw,4.8rem); line-height:1.12; letter-spacing:-.025em; margin:14px 0 34px; }
  p:not(.eyebrow) { color:var(--muted); }
  @media (max-width:600px) { .page { margin:30px auto; padding:30px 24px; } }
</style>
