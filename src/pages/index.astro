---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/date';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="posts" aria-label="文章列表">
    <p class="eyebrow">Latest writing</p>
    {posts.map((post) => (
      <article>
        <div class="meta">{formatDate(post.data.pubDate)}</div>
        <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div>{post.data.tags.map(tag => <a class="tag" href={`/tags#${tag}`}>{tag}</a>)}</div>
      </article>
    ))}
  </section>
</BaseLayout>
<style>
  .posts { max-width:760px; padding-top:34px; }
  article { position:relative; padding:32px 28px 36px; border-bottom:1px solid var(--line); transition:background-color .22s ease,transform .22s ease; }
  article::before { position:absolute; top:0; bottom:0; left:0; width:2px; background:var(--accent); content:''; opacity:0; transform:scaleY(.35); transition:opacity .22s ease,transform .22s ease; }
  article:hover { background:linear-gradient(90deg,var(--accent-soft),transparent 72%); transform:translateX(4px); }
  article:hover::before { opacity:1; transform:scaleY(1); }
  .meta { color:var(--muted); font:.7rem 'DM Mono',monospace; letter-spacing:.08em; }
  h2 { font-size:clamp(1.7rem,3vw,2.15rem); letter-spacing:.01em; margin:8px 0 6px; line-height:1.35; }
  h2 a:hover { color:var(--accent); }
  article p { color:var(--muted); margin:0 0 17px; }
  @media (max-width:600px) { .posts { padding-top:20px; } article { padding:26px 12px 30px; } }
</style>
