---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/date';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="posts" aria-label="文章列表">
    <p class="eyebrow">Latest writing</p>
    {posts.map((post) => (
      <article>
        <div class="meta">{formatDate(post.data.pubDate)}</div>
        <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div>{post.data.tags.map(tag => <a class="tag" href={`/tags#${tag}`}>{tag}</a>)}</div>
      </article>
    ))}
  </section>
</BaseLayout>
<style>
  .posts { width:100%; padding-top:8px; }
  .posts > .eyebrow { margin:0 0 40px; }
  article { display:grid; grid-template-columns:minmax(0,1fr) auto; column-gap:22px; margin:0 0 36px; }
  .meta { grid-column:2; grid-row:1; align-self:baseline; margin-top:.5rem; color:var(--muted); font-size:.72rem; white-space:nowrap; }
  h2 { grid-column:1; grid-row:1; margin:0 0 7px; font-size:1.55rem; line-height:1.35; letter-spacing:-.025em; }
  h2 a { color:var(--accent); }
  h2 a:hover { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:4px; }
  article p { grid-column:1 / -1; margin:0 0 8px; color:var(--ink); font-size:.9rem; }
  article > div:last-child { grid-column:1 / -1; }
  @media (max-width:600px) { .posts > .eyebrow { margin-bottom:32px; } article { grid-template-columns:1fr; margin-bottom:34px; } h2 { grid-column:1; grid-row:1; font-size:1.42rem; } .meta { grid-column:1; grid-row:2; margin:0 0 7px; } article p { grid-row:3; } article > div:last-child { grid-row:4; } }
</style>
