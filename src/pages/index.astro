---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/date';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Personal notes / since 2026</p>
    <h1>把日子写成<br /><em>自己的答案。</em></h1>
    <p>这里记录思考、学习和那些正在发生的创造。</p>
  </section>
  <section class="posts" aria-label="文章列表">
    <p class="eyebrow">Latest writing</p>
    {posts.map((post) => (
      <article>
        <div class="meta">{formatDate(post.data.pubDate)}</div>
        <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div>{post.data.tags.map(tag => <a class="tag" href={`/tags#${tag}`}>{tag}</a>)}</div>
      </article>
    ))}
  </section>
</BaseLayout>
<style>
  .hero { padding:55px 0 88px; border-bottom:1px solid var(--line); }
  h1 { font-size:clamp(2.7rem, 6vw, 5rem); line-height:1.25; letter-spacing:-.06em; margin:14px 0 18px; }
  h1 em { color:var(--accent); font-style:normal; }
  .hero > p:last-child { color:var(--muted); font-size:1.08rem; }
  .posts { max-width:720px; padding-top:55px; }
  article { padding:30px 0 34px; border-bottom:1px solid var(--line); }
  .meta { color:var(--muted); font:.75rem 'DM Mono', monospace; }
  h2 { font-size:1.65rem; margin:8px 0 4px; line-height:1.45; } h2 a:hover { color:var(--accent); }
  article p { color:var(--muted); margin:0 0 14px; }
</style>