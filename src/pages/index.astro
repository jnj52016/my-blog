---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/date';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="posts" aria-label="文章列表">
    {posts.map((post) => (
      <article>
        <div class="meta">{formatDate(post.data.pubDate)}</div>
        <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div>{post.data.tags.map(tag => <a class="tag" href={`/tags#${tag}`}>{tag}</a>)}</div>
      </article>
    ))}
  </section>
</BaseLayout>
<style>
  .posts { width:100%; padding-top:18px; }
  article { position:relative; display:flex; flex-direction:column; margin:0 -16px 42px; padding:14px 16px 20px; cursor:pointer; }
  .meta { order:2; margin:2px 0 2px; color:var(--muted); font-size:.78rem; }
  h2 { order:1; margin:0; font-family:'Montserrat','Noto Serif SC',sans-serif; font-size:clamp(1.65rem,4vw,2rem); font-weight:900; line-height:1.25; letter-spacing:-.045em; }
  h2 a { color:var(--accent); text-shadow:.5px .5px 0 rgba(77,3,8,.22); }
  h2 a::after { position:absolute; inset:0; content:''; }
  h2 a:hover { color:var(--accent-hover); }
  article p { order:3; margin:0 0 6px; color:var(--ink); font-size:.98rem; }
  article > div:last-child { position:relative; z-index:1; order:4; width:max-content; max-width:100%; }
  @media (max-width:600px) { .posts { padding-top:10px; } article { margin:0 -10px 34px; padding:12px 10px 18px; } h2 { font-size:1.5rem; } }
</style>
