---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<BaseLayout title="标签 · 留白">
  <section class="page"><p class="eyebrow">Topics</p><h1>标签</h1><div class="tags">{tags.map(tag => <a id={tag} class="tag" href={`#${tag}`}>{tag}</a>)}</div></section>
</BaseLayout>
<style>
  .page { width:100%; margin:28px auto; }
  h1 { margin:10px 0 30px; font-size:clamp(2.1rem,5vw,3rem); line-height:1.3; letter-spacing:-.035em; }
  .tags { display:flex; flex-wrap:wrap; gap:10px 18px; }
  .tag { margin:0; font-size:.92rem; }
</style>
