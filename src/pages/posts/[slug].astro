---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/date';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} · 留白`} description={post.data.description}>
  <article class="post">
    <a class="back" href="/">← 返回文章列表</a>
    <p class="eyebrow">更新于 {formatDate(post.data.updatedDate ?? post.data.pubDate)}</p>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <div class="tags">{post.data.tags.map(tag => <a class="tag" href={`/tags#${tag}`}>{tag}</a>)}</div>
    <div class="content"><Content /></div>
  </article>
</BaseLayout>
<style>
  .post { width:100%; margin:22px auto; }
  .back { color:var(--accent); font-size:.78rem; }
  .back:hover { color:var(--accent); }
  .back:hover { text-decoration:underline; text-underline-offset:3px; }
  .eyebrow { margin:54px 0 12px; }
  h1 { max-width:700px; margin:0; color:var(--accent); font-family:'Montserrat','Noto Serif SC',sans-serif; font-size:clamp(2.15rem,5vw,3.15rem); font-weight:900; letter-spacing:-.045em; line-height:1.22; text-shadow:.5px .5px 0 rgba(77,3,8,.22); }
  .lead { max-width:660px; margin:18px 0; color:var(--muted); font-size:1rem; font-style:italic; }
  .tags { margin-bottom:48px; }
  .content { font-size:1.02rem; }
  .content :global(p) { margin:0 0 26px; }
  .content :global(h2) { margin:48px 0 18px; font-size:1.75rem; line-height:1.4; letter-spacing:-.025em; }
  .content :global(h3) { margin:38px 0 14px; font-size:1.35rem; line-height:1.45; }
  .content :global(a) { color:var(--accent); text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:3px; }
  .content :global(blockquote) { margin:32px 0; padding:2px 0 2px 20px; border-left:3px solid var(--accent); color:var(--muted); font-style:italic; }
  .content :global(code) { border-radius:3px; background:var(--inline-code-bg); padding:.14em .34em; color:var(--inline-code-text); font-family:Consolas,'Courier New',monospace; font-size:.88em; }
  .content :global(pre) { overflow-x:auto; margin:30px 0; padding:20px; border-radius:6px; background:var(--code-bg); color:#f4f4f4; }
  .content :global(pre code) { border:0; background:none; padding:0; color:inherit; }
  .content :global(hr) { width:100px; margin:48px auto; border:0; border-top:1px solid var(--muted); opacity:.35; }
  @media (max-width:600px) { .post { margin-top:14px; } .eyebrow { margin-top:42px; } h1 { font-size:clamp(2rem,10vw,2.7rem); } }
</style>
