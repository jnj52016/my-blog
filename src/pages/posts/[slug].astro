---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/date';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} · 留白`} description={post.data.description}>
  <article class="post">
    <a class="back" href="/">← 返回文章列表</a>
    <p class="eyebrow">{formatDate(post.data.pubDate)}</p>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <div class="tags">{post.data.tags.map(tag => <a class="tag" href={`/tags#${tag}`}>{tag}</a>)}</div>
    <div class="content"><Content /></div>
  </article>
</BaseLayout>
<style>
  .post { max-width:720px; margin:24px auto; } .back { color:var(--muted); font-size:.88rem; }
  .eyebrow { margin:60px 0 12px; } h1 { font-size:clamp(2.3rem,5vw,4rem); letter-spacing:-.055em; line-height:1.28; margin:0; }
  .lead { color:var(--muted); font-size:1.14rem; margin:18px 0; } .tags { margin-bottom:52px; }
  .content { font-size:1.08rem; } .content :global(p) { margin:0 0 24px; }
</style>